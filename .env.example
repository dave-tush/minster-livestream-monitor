# --- Required ---
YOUTUBE_API_KEY=your-youtube-api-key
MINISTER_NAME=Pastor Toluwalogo Agboola

# --- WordPress (used from Stage 5) ---
WORDPRESS_URL=https://example.com
WORDPRESS_API_KEY=generate-a-long-random-string

# --- Protects POST /check-now on this service (send it as the X-API-Key header).
# Leave empty to disable /check-now entirely. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Matching ---
# Comma-separated or JSON list of YouTube channel IDs (start with UC). Empty = search broadly.
TRUSTED_CHANNEL_IDS=
# true  = only accept streams from TRUSTED_CHANNEL_IDS
# false = trusted channels are preferred, but name-matched streams elsewhere are accepted too
TRUSTED_ONLY=false

# --- Polling / quota ---
# Cheap check (1-2 quota units): trusted channel uploads + verifying the current stream
CHECK_INTERVAL_SECONDS=60
# Expensive keyword search (100 quota units each). 1800 = every 30 min = 4,800 units/day.
# Not needed if TRUSTED_ONLY=true.
DISCOVERY_INTERVAL_SECONDS=1800
# Your YouTube API daily quota (default 10000). The monitor skips keyword searches when
# fewer than ~1,600 units remain, so cheap live-checks keep working all day.
DAILY_QUOTA_BUDGET=10000

# --- Storage ---
DATABASE_URL=sqlite:///./data/monitor.db

# --- Dominion Radio (24/7 radio from a Telegram channel) ---
# Leave the TELEGRAM_* values empty to run without the radio.
# 1) Get API ID + hash: https://my.telegram.org -> API development tools
# 2) Generate the session string on your own computer: python scripts/telegram_login.py
# The account must be able to see the channel (join it first if it is public/private).
RADIO_NAME=Dominion Radio
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Channel @username, t.me link, or numeric id (e.g. -1001234567890)
TELEGRAM_CHANNEL=
# Audio is downloaded on demand into this folder; oldest files are deleted above the size limit.
RADIO_CACHE_DIR=./data/radio
RADIO_CACHE_MAX_MB=1024
# How often to check the channel for new uploads, and how many upcoming tracks to pre-download.
RADIO_SYNC_INTERVAL_SECONDS=300
RADIO_PREFETCH_COUNT=2

# --- Thumbnail verification ---
# Reads the text printed on a stream's thumbnail (usually the minister's name) and adds it as evidence.
# Works on ANY channel and costs no YouTube quota. Needs: python -m pip install -r requirements-ocr.txt
# If the OCR engine isn't installed the monitor logs a warning and carries on without it.
THUMBNAIL_OCR=true
# auto (default): use rapidocr if installed, otherwise tesseract. Or force: rapidocr / tesseract.
THUMBNAIL_OCR_ENGINE=auto
# Max thumbnails read per check (results are cached, so repeat checks cost nothing)
THUMBNAIL_OCR_MAX_PER_CHECK=6
# Other ways the name is written on thumbnails, comma-separated. Example: Pst Tolu Agboola, Tolu Agboola
MINISTER_ALIASES=
